{
  "name": "vrchat-photo-loader",
  "version": "0.1.0",
  "private": true,
  "description": "ローカルのPNG写真をGitHubにアップロードし、VRChat用URL一覧とUdonSharpコードを生成するCLIツール",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "vrc-photos": "./dist/index.js"
  },
  "scripts": {
    "dev": "node --watch dist/index.js",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "sharp": "^0.35.3",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  }
}
